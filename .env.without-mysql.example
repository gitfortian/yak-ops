# Frontend Nginx image
YAK_OPS_IMAGE=yak-ops:local

# Backend image
YAK_OPS_API_IMAGE=yak-ops-api:local

# Browser access port
YAK_OPS_PORT=9001

# MySQL
MYSQL_USER=root
MYSQL_PASSWORD=change_me
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_DATABASE=yak_ops

# JVM
JAVA_OPTS=-Xms512m -Xmx1024m

# Spring Boot additional arguments
APP_OPTS=

# Enable only for a new database and set a unique administrator password.
YAK_SECURITY_BOOTSTRAP_ENABLED=false
YAK_SECURITY_BOOTSTRAP_USERNAME=root
YAK_SECURITY_BOOTSTRAP_PASSWORD=

# Master key used to AES-GCM encrypt datasource passwords. Replace before production use.
YAK_OPS_DATASOURCE_MASTER_KEY=change_me
